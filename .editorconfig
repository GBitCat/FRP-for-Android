# EditorConfig helps maintain consistent coding styles
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{java,kt}]
indent_style = space
indent_size = 4

[*.{xml,json,yml,yaml}]
indent_style = space
indent_size = 2

[*.gradle]
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[*.properties]
charset = utf-8
